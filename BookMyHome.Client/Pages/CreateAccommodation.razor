@page "/accommodations/create"

@using BookMyHome.Client.Models
@using BookMyHome.Client.Services
@using Microsoft.AspNetCore.Components.Forms

@inject AccommodationService AccommodationService
@inject NavigationManager NavigationManager

<header class="page-header"><div><h1>Add Property</h1><p>List a new accommodation for guests to book.</p></div></header>
<div class="page-body"><EditForm class="form-card" Model="model" OnValidSubmit="HandleCreate">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="field">
        <label class="form-label">Name</label>

        <InputText class="form-control"
                   @bind-Value="model.Name" />
    </div>

    <div class="field">
        <label class="form-label">Address</label>

        <InputText class="form-control"
                   @bind-Value="model.Address" />
    </div>

    <div class="field">
        <label class="form-label">Price per night</label>

        <InputNumber class="form-control"
                     @bind-Value="model.PricePerNight" />
    </div>

    <div class="field">
        <label class="form-label">Description</label>

        <InputTextArea class="form-control"
                       @bind-Value="model.Description"
                       rows="5" />
    </div>

    <div class="field">
    <label class="form-label">Property images</label>

    <InputFile OnChange="OnFilesSelected"
               multiple
               accept="image/jpeg,image/png,image/webp" />

    <small class="form-text text-muted">
        Select up to 10 JPG, PNG, or WebP images. Maximum 10 MB per image.
    </small>

    @if (selectedFiles.Count > 0)
    {
        <p class="mt-2">
            @selectedFiles.Count image(s) selected.
        </p>

        <ul>
            @foreach (var file in selectedFiles)
            {
                <li>@file.Name</li>
            }
        </ul>
    }
</div>

    <h2>Property facts</h2>
    <div class="field"><label class="form-label">Floor area (m²)</label><InputNumber class="form-control" @bind-Value="model.FloorAreaSquareMeters" /></div>
    <div class="field"><label class="form-label">Bedrooms</label><InputNumber class="form-control" @bind-Value="model.Bedrooms" /></div>
    <div class="field"><label class="form-label">Bathrooms</label><InputNumber class="form-control" @bind-Value="model.Bathrooms" /></div>
    <div class="field"><label class="form-label">Maximum guests</label><InputNumber class="form-control" @bind-Value="model.MaxGuests" /></div>

    <h2>Comfort and amenities</h2>
    <label class="field"><InputCheckbox @bind-Value="model.HasAirConditioning" /> Air conditioning</label>
    <label class="field"><InputCheckbox @bind-Value="model.HasHeatedFloors" /> Heated floors</label>
    <label class="field"><InputCheckbox @bind-Value="model.HasWifi" /> Wi-Fi</label>
    <label class="field"><InputCheckbox @bind-Value="model.HasKitchen" /> Kitchen</label>
    <label class="field"><InputCheckbox @bind-Value="model.HasParking" /> Parking</label>
    <label class="field"><InputCheckbox @bind-Value="model.HasWasher" /> Washer</label>
    <label class="field"><InputCheckbox @bind-Value="model.HasTv" /> TV</label>
    <label class="field"><InputCheckbox @bind-Value="model.HasBalcony" /> Balcony</label>
    <label class="field"><InputCheckbox @bind-Value="model.HasPool" /> Pool</label>

    <h2>House rules</h2>
    <label class="field"><InputCheckbox @bind-Value="model.PetsAllowed" /> Pets allowed</label>
    <label class="field"><InputCheckbox @bind-Value="model.SmokingAllowed" /> Smoking allowed</label>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    <button type="submit"
            class="btn btn-primary">
        Create
    </button>

    <button type="button"
            class="btn btn-secondary ms-2"
            @onclick="Cancel">
        Cancel
    </button>

</EditForm></div>

@code {

    
    private CreateAccommodationDto model = new()
    {
        // Midlertidig test-host indtil vi laver login/Host UI
        HostId = Guid.Parse(
            "33333333-3333-3333-3333-333333333333")
    };

    private string? errorMessage;

private IReadOnlyList<IBrowserFile> selectedFiles =
    Array.Empty<IBrowserFile>();

        private void OnFilesSelected(InputFileChangeEventArgs args)
{
    selectedFiles = args.GetMultipleFiles(10);
}

private async Task HandleCreate()
{
    errorMessage = null;

    var response =
        await AccommodationService.CreateAsync(model);

    if (!response.IsSuccessStatusCode)
    {
        errorMessage =
            await response.Content.ReadAsStringAsync();

        return;
    }

    var accommodation =
        await response.Content.ReadFromJsonAsync<AccommodationDto>();

    if (accommodation == null)
    {
        errorMessage =
            "The accommodation was created, but its ID could not be read.";

        return;
    }

    if (selectedFiles.Count > 0)
    {
        var imageResponse =
            await AccommodationService.UploadImagesAsync(
                accommodation.AccommodationId,
                selectedFiles);

        if (!imageResponse.IsSuccessStatusCode)
        {
            errorMessage =
                "The accommodation was created, but the images could not be uploaded.";

            return;
        }
    }

    NavigationManager.NavigateTo("/accommodations");
}

    private void Cancel()
    {
        NavigationManager.NavigateTo("/accommodations");
    }
}