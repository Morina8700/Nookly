@page "/login"
@using BookMyHome.Client.Models
@using BookMyHome.Client.Services
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Login</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="eyebrow">Your next stay starts here</div>
        <h1>Welcome back</h1>
        <p>Sign in to manage your reservations and discover a place that feels like home.</p>

        <EditForm Model="@request" OnValidSubmit="@LoginAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="field">
                <label class="form-label" for="email">Email address</label>
                <InputText id="email" class="form-control" @bind-Value="request.Email" />
            </div>

            <div class="field">
                <label class="form-label" for="password">Password</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="request.Password" />
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">
                @(isSubmitting ? "Signing in..." : "Sign in")
            </button>
        </EditForm>
    </div>
</div>

@code {
    private readonly LoginRequest request = new();
    private string? errorMessage;
    private bool isSubmitting;

    private async Task LoginAsync()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var result = await AuthService.LoginAsync(request);

            if (result.Success)
            {
                NavigationManager.NavigateTo("/");
                return;
            }

            errorMessage = string.IsNullOrWhiteSpace(result.Error)
                ? "Login failed."
                : result.Error;
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "The API could not be reached. Check that BookMyHome.Application is running.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
