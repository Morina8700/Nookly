@page "/bookings/edit/{Id:guid}"

@using BookMyHome.Client.Models
@using BookMyHome.Client.Services

@inject BookingService BookingService
@inject AccommodationService AccommodationService
@inject NavigationManager NavigationManager

<header class="page-header"><div><h1>Edit Booking</h1><p>Update the details of your reservation.</p></div></header>

@if (isLoading)
{
    <p>Loading...</p>
}
else
{
    <div class="page-body"><EditForm class="form-card" Model="model"
              OnValidSubmit="HandleUpdateBooking">

        <div class="field">
            <label class="form-label">
                Accommodation
            </label>

            <InputSelect class="form-select"
                         @bind-Value="model.AccommodationId">

                @foreach (var accommodation in accommodations)
                {
                    <option value="@accommodation.AccommodationId">
                        @accommodation.Name
                    </option>
                }

            </InputSelect>
        </div>

        <div class="field">
            <label class="form-label">
                Start date
            </label>

            <InputDate class="form-control"
                       @bind-Value="model.StartDate" />
        </div>

        <div class="field">
            <label class="form-label">
                End date
            </label>

            <InputDate class="form-control"
                       @bind-Value="model.EndDate" />
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">
                @errorMessage
            </div>
        }

        <div class="form-actions">
            <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>

    </EditForm></div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private UpdateBookingDto model = new();

    private List<AccommodationDto> accommodations = new();

    private string? errorMessage;

    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        accommodations =
            await AccommodationService.GetAllAsync();

        var booking =
            await BookingService.GetByIdAsync(Id);

        if (booking == null)
        {
            NavigationManager.NavigateTo("/bookings");
            return;
        }

        model = new UpdateBookingDto
        {
            StartDate = booking.StartDate,
            EndDate = booking.EndDate,
            AccommodationId = booking.AccommodationId,
            RowVersion = booking.RowVersion
        };

        isLoading = false;
    }

    private async Task HandleUpdateBooking()
    {
        errorMessage = null;

        var response =
            await BookingService.UpdateAsync(Id, model);

        if (response.IsSuccessStatusCode)
        {
            NavigationManager.NavigateTo("/bookings");
            return;
        }

        errorMessage =
            await response.Content.ReadAsStringAsync();
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/bookings");
    }
}