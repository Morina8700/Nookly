@page "/accommodations/{Id:guid}"
@using BookMyHome.Client.Models
@using BookMyHome.Client.Services
@inject AccommodationService AccommodationService
@inject NavigationManager NavigationManager
@inject  HttpClient Http

@if (accommodation == null)
{
    <div class="page-body"><p>Loading...</p></div>
}
else
{
    <header class="page-header detail-page-header">
        <div>
            <div class="eyebrow">A place to settle in</div>
            <h1>@accommodation.Name</h1>
            <p>Everything you need to know before your stay</p>
        </div>
        <button class="btn btn-warning" @onclick="GoBack">Back to accommodations</button>
    </header>

    <div class="page-body">
        <article class="detail-card">
            @if (accommodation.Images.Any())
            {
                <div class="detail-gallery">
                    <img src="@GetImageUrl(accommodation.Images[currentImageIndex].ImageUrl)" alt="@accommodation.Name" class="detail-hero" />
                    @if (accommodation.Images.Count > 1)
                    {
                        <div class="detail-gallery-strip">
                            @foreach (var image in accommodation.Images.Take(4))
                            {
                                <button class="gallery-thumb" @onclick="() => SelectImage(accommodation.Images.IndexOf(image))">
                                    <img src="@GetImageUrl(image.ImageUrl)" alt="" />
                                </button>
                            }
                        </div>
                        <div class="image-controls"><button @onclick="PreviousImage" aria-label="Previous image">←</button><span>@(currentImageIndex + 1) / @accommodation.Images.Count</span><button @onclick="NextImage" aria-label="Next image">→</button></div>
                    }
                </div>
            }
            <div class="detail-content">
                <h1>@accommodation.Name</h1>
                <div class="location">⌖ @accommodation.Address</div>
                <p class="description">@accommodation.Description</p>
                <div class="stat-grid">
                    <div class="stat">
                        <small>Price per night</small>
                        <strong>@accommodation.PricePerNight kr.</strong>
                    </div>
                    @if (accommodation.Images.Any())
                    {
                        <div class="stat">
                            <small>Property photos</small>
                            <strong>@accommodation.Images.Count</strong>
                        </div>
                    }
                </div>
                <h2>Property facts</h2>
                <div class="stat-grid">
                    <div class="stat"><small>Floor area</small><strong>@accommodation.FloorAreaSquareMeters m²</strong></div>
                    <div class="stat"><small>Bedrooms</small><strong>@accommodation.Bedrooms</strong></div>
                    <div class="stat"><small>Bathrooms</small><strong>@accommodation.Bathrooms</strong></div>
                    <div class="stat"><small>Maximum guests</small><strong>@accommodation.MaxGuests</strong></div>
                </div>
                <h2>Amenities</h2>
                <ul class="amenity-list">
                    @if (accommodation.HasAirConditioning) { <li>Air conditioning</li> }
                    @if (accommodation.HasHeatedFloors) { <li>Heated floors</li> }
                    @if (accommodation.HasWifi) { <li>Wi-Fi</li> }
                    @if (accommodation.HasKitchen) { <li>Kitchen</li> }
                    @if (accommodation.HasParking) { <li>Parking</li> }
                    @if (accommodation.HasWasher) { <li>Washer</li> }
                    @if (accommodation.HasTv) { <li>TV</li> }
                    @if (accommodation.HasBalcony) { <li>Balcony</li> }
                    @if (accommodation.HasPool) { <li>Pool</li> }
                </ul>
                <h2>House rules</h2>
                <ul class="amenity-list">
                    <li>Pets @(accommodation.PetsAllowed ? "allowed" : "not allowed")</li>
                    <li>Smoking @(accommodation.SmokingAllowed ? "allowed" : "not allowed")</li>
                </ul>
                <a class="btn btn-primary" href="@($"/accommodations/edit/{accommodation.AccommodationId}")">✎ Edit Property</a>
            </div>
        </article>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private AccommodationDto? accommodation;
    private int currentImageIndex;

    protected override async Task OnInitializedAsync()
        => accommodation = await AccommodationService.GetByIdAsync(Id);

    private void NextImage()
    {
        if (accommodation is null || accommodation.Images.Count == 0) return;
        currentImageIndex = (currentImageIndex + 1) % accommodation.Images.Count;
    }

    private void PreviousImage()
    {
        if (accommodation is null || accommodation.Images.Count == 0) return;
        currentImageIndex = (currentImageIndex - 1 + accommodation.Images.Count) % accommodation.Images.Count;
    }

    private void SelectImage(int index) => currentImageIndex = index;

    private void GoBack() => NavigationManager.NavigateTo("/accommodations");

private string GetImageUrl(string imageUrl)
{
    return new Uri(Http.BaseAddress!, imageUrl).AbsoluteUri;
}
}
