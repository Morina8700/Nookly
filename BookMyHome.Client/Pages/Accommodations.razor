@page "/accommodations"

@using BookMyHome.Client.Models
@using BookMyHome.Client.Services

@inject AccommodationService AccommodationService

<header class="page-header">
    <div>
        <h1>Accommodations</h1>
        <p>@(accommodations?.Count ?? 0) properties listed</p>
    </div>
    <a href="/accommodations/create" class="btn btn-primary">＋ Add Property</a>
</header>

<div class="page-body">
    @if (accommodations == null)
    {
        <p>Loading...</p>
    }
    else if (accommodations.Count == 0)
    {
        <div class="table-card empty-state">No accommodations found.</div>
    }
    else
    {
        <div class="property-grid">

        @foreach (var accommodation in accommodations)
        {
            <article class="property-card">
                <a href="@($"/accommodations/{accommodation.AccommodationId}")" class="property-link">
                    @if (accommodation.Images.Any())
                    {
                        <img src="@accommodation.Images.First().ImageUrl" class="property-card-image" alt="@accommodation.Name" />
                    }
                    else
                    {
                        <div class="property-card-image image-placeholder">No image</div>
                    }
                    <div class="property-card-body">
                        <h2>@accommodation.Name</h2>
                        <p class="location">⌖ @accommodation.Address</p>
                        <p>@accommodation.Description</p>
                        <div class="price"><strong>@accommodation.PricePerNight</strong> kr. / night</div>
                    </div>
                </a>
                <div class="property-card-actions">
                        <a class="btn btn-warning"
                           href="@($"/accommodations/edit/{accommodation.AccommodationId}")">
                            ✎ Edit
                        </a>
                        <button class="btn btn-danger"
                                @onclick="() => DeleteAccommodation(accommodation.AccommodationId)">
                            ▣ Delete
                        </button>
                </div>
            </article>
        }

        </div>
    }
</div>

@code {
    private List<AccommodationDto>? accommodations;

    protected override async Task OnInitializedAsync()
    {
        accommodations =
            await AccommodationService.GetAllAsync();
    }

    private async Task DeleteAccommodation(Guid id)
    {
        await AccommodationService.DeleteAsync(id);

        accommodations =
            await AccommodationService.GetAllAsync();
    }
}