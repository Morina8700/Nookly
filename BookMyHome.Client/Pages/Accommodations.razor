@page "/accommodations"

@using BookMyHome.Client.Models
@using BookMyHome.Client.Services

@inject AccommodationService AccommodationService
@inject HttpClient Http

<header class="browse-header">
    <div>
        <div class="eyebrow">Find your next place</div>
        <h1>Stays for every kind of trip</h1>
        <p>@(accommodations?.Count ?? 0) places ready to explore</p>
    </div>
    <a href="/accommodations/create" class="btn btn-primary">＋ Add Property</a>
</header>

<div class="page-body">
    <div class="browse-layout">
        <aside class="filter-panel">
            <div class="filter-panel-heading"><span>Refine your search</span><button type="button" class="text-button" @onclick="ClearFilters">Clear all</button></div>
            <EditForm Model="filters" OnValidSubmit="ApplyFilters">
            <div class="field">
                <label class="form-label">
                    Location
                </label>

                <InputText class="form-control"
                           @bind-Value="filters.Location" />
            </div>

            <div class="field">
                <label class="form-label">
                    Minimum price
                </label>

                <InputNumber class="form-control"
                             @bind-Value="filters.MinPrice" />
            </div>

            <div class="field">
                <label class="form-label">
                    Maximum price
                </label>

                <InputNumber class="form-control"
                             @bind-Value="filters.MaxPrice" />
            </div>

            <div class="field">
                <label class="form-label">
                    Minimum guests
                </label>

                <InputNumber class="form-control"
                             @bind-Value="filters.MaxGuests" />
            </div>

            <div class="field">
                <label class="form-label">
                    Wi-Fi
                </label>

                <InputSelect class="form-select"
                             @bind-Value="filters.HasWifi">
                    <option value="">Any</option>
                    <option value="true">Yes</option>
                    <option value="false">No</option>
                </InputSelect>
            </div>

            <button type="submit" class="btn btn-primary">
                Search
            </button>

            <button type="button"
                    class="btn btn-secondary filter-clear"
                    @onclick="ClearFilters">
                Clear
            </button>
            </EditForm>
        </aside>

        <section class="browse-results">
            <div class="results-heading"><div><strong>Available stays</strong><span>Handpicked for your search</span></div><span class="results-count">@(accommodations?.Count ?? 0) results</span></div>
    @if (accommodations == null)
    {
        <p>Loading...</p>
    }
    else if (accommodations.Count == 0)
    {
        <div class="table-card empty-state">No accommodations found.</div>
    }
    else
    {
        <div class="property-grid">

        @foreach (var accommodation in accommodations)
        {
            <article class="property-card">
                <a href="@($"/accommodations/{accommodation.AccommodationId}")" class="property-link">
                    @if (accommodation.Images.Any())
                    {
                        <img src="@GetImageUrl(accommodation.Images.First().ImageUrl)" class="property-card-image" alt="@accommodation.Name" />
                    }
                    else
                    {
                        <div class="property-card-image image-placeholder">No image</div>
                    }
                    <div class="property-card-body">
                        <h2>@accommodation.Name</h2>
                        <p class="location">⌖ @accommodation.Address</p>
                        <p class="property-facts">@accommodation.MaxGuests guests · @accommodation.Bedrooms bedrooms</p>
                        <p>@accommodation.Description</p>
                        <div class="price"><strong>@accommodation.PricePerNight</strong> kr. / night</div>
                    </div>
                </a>
                <div class="property-card-actions">
                        <a class="btn btn-warning"
                           href="@($"/accommodations/edit/{accommodation.AccommodationId}")">
                            Edit
                        </a>
                        <button class="btn btn-danger"
                                @onclick="() => DeleteAccommodation(accommodation.AccommodationId)">
                            Delete
                        </button>
                </div>
            </article>
        }

        </div>
    }
        </section>
    </div>
</div>

@code {
    private AccommodationFilters filters = new();
    private List<AccommodationDto>? accommodations;

    protected override async Task OnInitializedAsync()
    {
        await ApplyFilters();
    }
    private async Task ApplyFilters()
{
    accommodations =
        await AccommodationService.GetAllAsync(
            filters.Location,
            filters.MinPrice,
            filters.MaxPrice,
            filters.HasWifi,
            filters.MaxGuests);
}

private async Task ClearFilters()
{
    filters = new AccommodationFilters();

    await ApplyFilters();
}

    private async Task DeleteAccommodation(Guid id)
    {
        await AccommodationService.DeleteAsync(id);

        await ApplyFilters();
    }

private string GetImageUrl(string imageUrl)
{
    return new Uri(Http.BaseAddress!, imageUrl).AbsoluteUri;
}

public class AccommodationFilters
{
    public string? Location { get; set; }

    public decimal? MinPrice { get; set; }

    public decimal? MaxPrice { get; set; }

    public bool? HasWifi { get; set; }

    public int? MaxGuests { get; set; }
}
}