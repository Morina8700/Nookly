@page "/bookings"

@using BookMyHome.Client.Models
@using BookMyHome.Client.Services

@inject BookingService BookingService
@inject AccommodationService AccommodationService
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<header class="page-header">
    <div>
        <div class="eyebrow">Your trips</div>
        <h1>Bookings</h1>
        <p>@(bookings?.Count ?? 0) reservations saved</p>
    </div>
    <a href="/bookings/create" class="btn btn-primary">＋ Create Booking</a>
</header>

<div class="page-body">
    <EditForm Model="filters" OnValidSubmit="ApplyFilters">
        <div class="form-card filter-card">
            <div class="field">
                <label class="form-label">
                    Accommodation
                </label>

                <InputSelect class="form-select"
                             @bind-Value="filters.AccommodationId">
                    <option value="@Guid.Empty">
                        All accommodations
                    </option>

                    @foreach (var accommodation in accommodations ?? [])
                    {
                        <option value="@accommodation.AccommodationId">
                            @accommodation.Name
                        </option>
                    }
                </InputSelect>
            </div>

            <div class="field">
                <label class="form-label">
                    From
                </label>

                <InputDate class="form-control"
                           @bind-Value="filters.From" />
            </div>

            <div class="field">
                <label class="form-label">
                    To
                </label>

                <InputDate class="form-control"
                           @bind-Value="filters.To" />
            </div>

            <button type="submit" class="btn btn-primary">
                Search
            </button>

            <button type="button"
                    class="btn btn-secondary ms-2"
                    @onclick="ClearFilters">
                Clear
            </button>
        </div>
    </EditForm>
</div>

<div class="page-body">
    @if (bookings == null)
    {
        <div class="loading-state">Loading your reservations...</div>
    }
    else if (bookings.Count == 0)
    {
        <div class="table-card empty-state">No bookings found.</div>
    }
    else
    {
        <div class="table-card">
            <table class="table">
        <thead>
            <tr>
                <th>Start date</th>
                <th>End date</th>
                <th>Accommodation</th>
                <th>Duration</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var booking in bookings)
            {
                <tr>
                    <td>@booking.StartDate.ToString("dd MMM yyyy")</td>
                    <td>@booking.EndDate.ToString("dd MMM yyyy")</td>
                    <td><strong>@GetAccommodationName(booking.AccommodationId)</strong></td>
                    <td><span class="duration-pill">@GetDuration(booking) nights</span></td>
                    <td>
                        <a class="btn btn-warning me-2"
                           href="@($"bookings/edit/{booking.BookingId}")">
                            ✎ Edit
                        </a>
                        <button class="btn btn-danger"
                                @onclick="() => DeleteBooking(booking.BookingId)">
                            ▣ Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
            </table>
        </div>
    }
</div>

@code {

public class BookingFilters
{
    public Guid AccommodationId { get; set; }

    public DateOnly? From { get; set; }

    public DateOnly? To { get; set; }
}
    private BookingFilters filters = new();
    private List<BookingDto>? bookings;
    private List<AccommodationDto>? accommodations;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        try
        {
        accommodations =
            await AccommodationService.GetAllAsync();

        await ApplyFilters();
        }
        catch (HttpRequestException exception)
            when (exception.StatusCode ==
                System.Net.HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    private async Task DeleteBooking(Guid id)
    {
        await BookingService.DeleteAsync(id);
        
        await ApplyFilters();
    }

    private string GetAccommodationName(Guid accommodationId)
    {
        var accommodation = accommodations?
            .FirstOrDefault(a =>
                a.AccommodationId == accommodationId);

        return accommodation?.Name ?? "Unknown";
    }

    

    private static int GetDuration(BookingDto booking)
        => booking.EndDate.DayNumber - booking.StartDate.DayNumber;



private async Task ApplyFilters()
{
   Guid? accommodationId =
        filters.AccommodationId == Guid.Empty
            ? null
            : filters.AccommodationId;

    bookings = await BookingService.GetAllAsync(
        accommodationId,
        filters.From,
        filters.To);
}

private async Task ClearFilters()
{
    filters = new BookingFilters();

    bookings =
        await BookingService.GetAllAsync();
}
}