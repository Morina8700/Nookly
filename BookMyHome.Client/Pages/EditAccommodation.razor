@page "/accommodations/edit/{Id:guid}"

@using BookMyHome.Client.Models
@using BookMyHome.Client.Services

@inject AccommodationService AccommodationService
@inject NavigationManager NavigationManager

<header class="page-header"><div><h1>Edit Property</h1><p>Update the details of this accommodation.</p></div></header>

@if (isLoading)
{
    <p>Loading...</p>
}
else
{
    <div class="page-body"><EditForm class="form-card" Model="model"
              OnValidSubmit="HandleUpdate">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="field">
            <label class="form-label">Name</label>

            <InputText class="form-control"
                       @bind-Value="model.Name" />
        </div>

        <div class="field">
            <label class="form-label">Address</label>

            <InputText class="form-control"
                       @bind-Value="model.Address" />
        </div>

        <div class="field">
            <label class="form-label">Price per night</label>

            <InputNumber class="form-control"
                         @bind-Value="model.PricePerNight" />
        </div>

        <div class="field">
            <label class="form-label">Description</label>

            <InputTextArea class="form-control"
                           @bind-Value="model.Description"
                           rows="5" />
        </div>

                    <h2>Property facts</h2>
                    <div class="field"><label class="form-label">Floor area (m²)</label><InputNumber class="form-control" @bind-Value="model.FloorAreaSquareMeters" /></div>
                    <div class="field"><label class="form-label">Bedrooms</label><InputNumber class="form-control" @bind-Value="model.Bedrooms" /></div>
                    <div class="field"><label class="form-label">Bathrooms</label><InputNumber class="form-control" @bind-Value="model.Bathrooms" /></div>
                    <div class="field"><label class="form-label">Maximum guests</label><InputNumber class="form-control" @bind-Value="model.MaxGuests" /></div>

                    <h2>Comfort and amenities</h2>
                    <label class="field"><InputCheckbox @bind-Value="model.HasAirConditioning" /> Air conditioning</label>
                    <label class="field"><InputCheckbox @bind-Value="model.HasHeatedFloors" /> Heated floors</label>
                    <label class="field"><InputCheckbox @bind-Value="model.HasWifi" /> Wi-Fi</label>
                    <label class="field"><InputCheckbox @bind-Value="model.HasKitchen" /> Kitchen</label>
                    <label class="field"><InputCheckbox @bind-Value="model.HasParking" /> Parking</label>
                    <label class="field"><InputCheckbox @bind-Value="model.HasWasher" /> Washer</label>
                    <label class="field"><InputCheckbox @bind-Value="model.HasTv" /> TV</label>
                    <label class="field"><InputCheckbox @bind-Value="model.HasBalcony" /> Balcony</label>
                    <label class="field"><InputCheckbox @bind-Value="model.HasPool" /> Pool</label>

                    <h2>House rules</h2>
                    <label class="field"><InputCheckbox @bind-Value="model.PetsAllowed" /> Pets allowed</label>
                    <label class="field"><InputCheckbox @bind-Value="model.SmokingAllowed" /> Smoking allowed</label>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">
                @errorMessage
            </div>
        }

        <button type="submit"
                class="btn btn-primary">
            Save Changes
        </button>

        <button type="button"
                class="btn btn-secondary ms-2"
                @onclick="Cancel">
            Cancel
        </button>

    </EditForm></div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private UpdateAccommodationDto model = new();

    private bool isLoading = true;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var accommodation =
            await AccommodationService.GetByIdAsync(Id);

        if (accommodation == null)
        {
            NavigationManager.NavigateTo("/accommodations");
            return;
        }

        model = new UpdateAccommodationDto
        {
            Name = accommodation.Name,
            Address = accommodation.Address,
            PricePerNight = accommodation.PricePerNight,
            Description = accommodation.Description,
            FloorAreaSquareMeters = accommodation.FloorAreaSquareMeters,
            Bedrooms = accommodation.Bedrooms,
            Bathrooms = accommodation.Bathrooms,
            MaxGuests = accommodation.MaxGuests,
            HasAirConditioning = accommodation.HasAirConditioning,
            HasHeatedFloors = accommodation.HasHeatedFloors,
            HasWifi = accommodation.HasWifi,
            HasKitchen = accommodation.HasKitchen,
            HasParking = accommodation.HasParking,
            HasWasher = accommodation.HasWasher,
            HasTv = accommodation.HasTv,
            HasBalcony = accommodation.HasBalcony,
            HasPool = accommodation.HasPool,
            PetsAllowed = accommodation.PetsAllowed,
            SmokingAllowed = accommodation.SmokingAllowed
        };

        isLoading = false;
    }

    private async Task HandleUpdate()
    {
        errorMessage = null;

        var response =
            await AccommodationService.UpdateAsync(Id, model);

        if (response.IsSuccessStatusCode)
        {
            NavigationManager.NavigateTo("/accommodations");
            return;
        }

        errorMessage =
            await response.Content.ReadAsStringAsync();
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/accommodations");
    }
}