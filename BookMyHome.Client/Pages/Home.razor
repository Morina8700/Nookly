@page "/"
@using BookMyHome.Client.Models
@using BookMyHome.Client.Services
@inject BookingService BookingService
@inject AccommodationService AccommodationService
@inject NavigationManager NavigationManager

<PageTitle>Home</PageTitle>

<header class="page-header">
    <div>
        <h1>Welcome back</h1>
        <p>Here's an overview of your bookings and accommodations.</p>
    </div>
</header>

<div class="page-body home-body">
    <div class="summary-grid">
        <div class="summary-card">
            <span class="summary-icon">▣</span>
            <strong>@(bookings?.Count ?? 0)</strong>
            <span>Bookings</span>
            <small>your reservations</small>
        </div>
        <div class="summary-card">
            <span class="summary-icon">▤</span>
            <strong>@(accommodations?.Count ?? 0)</strong>
            <span>Properties</span>
            <small>available to book</small>
        </div>
    </div>

    <section class="quick-actions">
        <h2>Quick actions</h2>
        <p>Jump straight to what you need.</p>
        <a class="btn btn-primary" href="/bookings/create">＋ New Booking</a>
        <a class="btn btn-warning ms-2" href="/accommodations">Browse Properties</a>
    </section>
</div>

@code {
    private List<BookingDto>? bookings;
    private List<AccommodationDto>? accommodations;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            bookings = await BookingService.GetAllAsync();
            accommodations = await AccommodationService.GetAllAsync();
        }
        catch (HttpRequestException exception)
            when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
    }
}
