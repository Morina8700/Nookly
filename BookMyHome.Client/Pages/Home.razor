@page "/"
@using BookMyHome.Client.Models
@using BookMyHome.Client.Services
@inject BookingService BookingService
@inject AccommodationService AccommodationService
@inject NavigationManager NavigationManager

<PageTitle>Home</PageTitle>

<div class="home-hero">
    <div class="home-hero-copy">
        <div class="eyebrow">Stay somewhere worth remembering</div>
        <h1>Find a place<br />that feels like yours.</h1>
        <p>Browse thoughtful stays, compare what matters, and make your next trip feel effortless.</p>
        <a class="btn btn-primary" href="/accommodations">Explore accommodations <span>→</span></a>
    </div>
    <div class="home-hero-art" aria-hidden="true">
        <div class="home-art-card home-art-card-back"></div>
        <div class="home-art-card home-art-card-front"><span>N</span></div>
    </div>
</div>

<div class="page-body home-body">
    <div class="home-section-heading">
        <div><div class="eyebrow">Your Nookly</div><h2>Everything in one place</h2></div>
        <a href="/bookings" class="text-link">View bookings →</a>
    </div>
    <div class="summary-grid">
        <div class="summary-card"><span class="summary-icon">▣</span><strong>@(bookings?.Count ?? 0)</strong><span>Bookings</span><small>your reservations</small></div>
        <div class="summary-card"><span class="summary-icon">▤</span><strong>@(accommodations?.Count ?? 0)</strong><span>Accommodations</span><small>places to discover</small></div>
    </div>
</div>

@code {
    private List<BookingDto>? bookings;
    private List<AccommodationDto>? accommodations;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            bookings = await BookingService.GetAllAsync();
            accommodations = await AccommodationService.GetAllAsync();
        }
        catch (HttpRequestException exception)
            when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            NavigationManager.NavigateTo("/login");
        }
    }
}
